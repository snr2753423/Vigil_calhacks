# Copy to .env (gitignored) and fill in. Read by backend/app/config.py.

# --- Tiger Cloud (TimescaleDB): Console → service → Connect → connection string
TIGER_DATABASE_URL=postgres://tsdbadmin:<password>@<host>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require

# --- Snowflake (key-pair auth; run `make keygen` and the SQL it prints)
SNOWFLAKE_ACCOUNT=<orgname>-<accountname>
# Your LOGIN_NAME (DESC USER), not the user NAME: on trial accounts it is often your email.
SNOWFLAKE_USER=<your Snowflake login name>
SNOWFLAKE_PRIVATE_KEY_PATH=secrets/snowflake_rsa_key.p8
SNOWFLAKE_ROLE=VIGIL_ROLE
SNOWFLAKE_WAREHOUSE=VIGIL_WH
SNOWFLAKE_DATABASE=VIGIL
# Claude model for Cortex (AI_COMPLETE / REST inference). `make check` lists what your account can use.
CORTEX_MODEL=claude-sonnet-5

# --- Simulation / facility
SEED_DAYS=3
FACILITY_TZ=America/Los_Angeles
# Seeded RNG for the roster and history (same seed → same residents and same "last night").
SIM_SEED=1337
# Stream simulated residents into Tiger while the backend runs (backfills gaps up to SIM_BACKFILL_MAX_HOURS).
SIM_LIVE_ENABLED=true
SIM_BACKFILL_MAX_HOURS=48
# Optional: the presenter's measured resting HR (bpm), used for R-120's seeded history.
# R120_RESTING_HR=68

# --- Fast-tier evaluator (scores all residents every EVAL_INTERVAL_S; SPEC §7)
EVALUATOR_ENABLED=true
EVAL_INTERVAL_S=2
# Full priority_snapshots write cadence; tier changes are always written at once.
SNAPSHOT_INTERVAL_S=10

# --- Deep tier: Tiger → Snowflake sync every SYNC_INTERVAL_S + ANOMALY_DETECTION per closed 15-min bucket
SNOWFLAKE_SYNC_ENABLED=true
SYNC_INTERVAL_S=60
ANOMALY_DETECT_ENABLED=true
# `make train` uses up to this many days, ending where last night's holdout starts (SPEC: days -14..-2).
ANOMALY_TRAIN_DAYS=12
# Optional: train on a bigger warehouse (multi-series training on XSMALL is slow: ~20+ min for 2 days × 120
# residents). Create it as ACCOUNTADMIN and GRANT USAGE, OPERATE ON WAREHOUSE … TO ROLE VIGIL_ROLE.
# SNOWFLAKE_TRAIN_WAREHOUSE=VIGIL_ML_WH

# --- Deep tier: Cortex AI assessments (tier rise to HIGH/CRITICAL, stale top-5, Refresh). Refresh works whenever
# Snowflake is configured; this only switches the automatic triggers. Care plans: `make care-plans`.
ASSESS_ENABLED=true

# --- Live hardware (Phase 7): the public HTTPS origin for the iPhone bed-sensor page (QR code on /devices).
# Paste the https://….trycloudflare.com address `make tunnel` prints (no trailing path); on Vultr, your domain.
# Re-read on every request in `make dev`, so no restart is needed after changing it.
# PUBLIC_URL=https://example-words.trycloudflare.com
# The 1-s device writer (Polar band + iPhone → Tiger). Tests turn it off.
DEVICE_INGEST_ENABLED=true

# --- Docker / Vultr only: Caddy site address (":8080" locally; your domain in production)
# SITE_ADDRESS=:8080
